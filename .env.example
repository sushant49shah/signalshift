# Copy to .env.local. Never use NEXT_PUBLIC_ for provider credentials.
APP_ORIGIN=http://localhost:3000
DETECTIF_API_KEY=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional access code required when creating a room. Set before exposing the demo.
DEMO_ACCESS_CODE=
# Persistent local storage; not suitable for ephemeral/serverless filesystems.
DATABASE_PATH=.data/signalshift.sqlite
