# Copy to .env.local. Never use NEXT_PUBLIC_ for provider credentials.
APP_ORIGIN=http://localhost:3000
DETECTIF_API_KEY=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional access code required when creating a room. Set before exposing the demo.
DEMO_ACCESS_CODE=
# Local development only. Vercel uses TURSO_DATABASE_URL and TURSO_AUTH_TOKEN below.
DATABASE_PATH=.data/signalshift.sqlite

# Required on Vercel: create a Turso libSQL database and a database auth token.
# Keep both server-side; do not add NEXT_PUBLIC_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
